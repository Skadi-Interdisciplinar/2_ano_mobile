<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- BARRA SUPERIOR DE AÇÕES (VOLTAR E COMPARTILHAR) -->
    <LinearLayout
        android:id="@+id/reportActionBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/primary_dark"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/btnBackReport"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_navy_btn"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_back_arrow_white"
                android:contentDescription="Voltar" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Relatório Gerado"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:fontFamily="@font/manrope"
            android:textStyle="bold"
            android:layout_marginStart="14dp" />

        <ImageView
            android:id="@+id/btnShareReport"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_download"
            android:contentDescription="Compartilhar ou Baixar" />
    </LinearLayout>

    <!-- DOCUMENTO VISUAL COM ROLAGEM -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/reportActionBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white">

            <!-- CABEÇALHO DO DOCUMENTO (FOTO 3) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/primary_dark"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">

                <!-- LOGO DO LOBO SKADI -->
                <ImageView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:src="@drawable/logo_skadi"
                    android:scaleType="centerInside"
                    android:contentDescription="Logo Skadi"
                    android:layout_marginEnd="14dp" />

                <!-- TÍTULO E SUBTÍTULO NORMATIVO ANVISA -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RELATÓRIO DE MONITORAMENTO SKADI"
                        android:textColor="@color/white"
                        android:textSize="13.5sp"
                        android:fontFamily="@font/manrope"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Conforme boas práticas de armazenamento e transporte de alimentos.\n(RDC nº216/2004 - ANVISA)"
                        android:textColor="#CBD5E1"
                        android:textSize="10.5sp"
                        android:fontFamily="@font/manrope"
                        android:lineSpacingMultiplier="1.15"
                        android:layout_marginTop="3dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- CORPO DO DOCUMENTO (SEÇÕES PADRONIZADAS) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- SEÇÃO 1: DADOS DO CENTRO DE DISTRIBUIÇÃO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <!-- FAIXA SUPERIOR AZUL ESCURO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_header_navy"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_doc_report_white"
                            android:contentDescription="Ícone dados"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DADOS DO CENTRO DE DISTRIBUIÇÃO"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:fontFamily="@font/manrope"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- CORPO DA TABELA COM BORDAS E FUNDO BRANCO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_body_rounded_bottom"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <!-- LINHA 1: NOME -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nome"
                                android:textColor="@color/primary_dark"
                                android:textSize="12sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="Belterra"
                                android:textColor="#2563EB"
                                android:textSize="12sp"
                                android:fontFamily="@font/manrope" />
                        </RelativeLayout>

                        <!-- LINHA 2: ENDEREÇO -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Endereço"
                                android:textColor="@color/primary_dark"
                                android:textSize="12sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="Rua Onze, 43 - São Paulo/SP"
                                android:textColor="#2563EB"
                                android:textSize="12sp"
                                android:fontFamily="@font/manrope" />
                        </RelativeLayout>

                        <!-- LINHA 3: CNPJ -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CNPJ"
                                android:textColor="@color/primary_dark"
                                android:textSize="12sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="12.345.678/0001-90"
                                android:textColor="#2563EB"
                                android:textSize="12sp"
                                android:fontFamily="@font/manrope" />
                        </RelativeLayout>

                        <!-- LINHA 4: RESPONSÁVEL TÉCNICO -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Responsável Técnico"
                                android:textColor="@color/primary_dark"
                                android:textSize="12sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="Beatriz Hinsching"
                                android:textColor="#2563EB"
                                android:textSize="12sp"
                                android:fontFamily="@font/manrope" />
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- SEÇÃO 2: DADOS DO RELATÓRIO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <!-- FAIXA SUPERIOR -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_header_navy"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_doc_report_white"
                            android:contentDescription="Ícone dados relatório"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DADOS DO RELATÓRIO"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:fontFamily="@font/manrope"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- CORPO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_body_rounded_bottom"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <!-- LINHA 1: CÂMARA / EQUIPAMENTO -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Câmara / Equipamento:"
                                android:textColor="@color/primary_dark"
                                android:textSize="12sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="Todas"
                                android:textColor="#2563EB"
                                android:textSize="12sp"
                                android:fontFamily="@font/manrope" />
                        </RelativeLayout>

                        <!-- LINHA 2: PERÍODO DO RELATÓRIO -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Período do Relatório"
                                android:textColor="@color/primary_dark"
                                android:textSize="12sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="11/08/2026 - 15/08/2026"
                                android:textColor="#2563EB"
                                android:textSize="12sp"
                                android:fontFamily="@font/manrope" />
                        </RelativeLayout>

                        <!-- LINHA 3: FAIXA DE TEMPERATURA -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Faixa de Temperatura(ºC)"
                                android:textColor="@color/primary_dark"
                                android:textSize="12sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="≤ -12ºC"
                                android:textColor="#2563EB"
                                android:textSize="12sp"
                                android:fontFamily="@font/manrope" />
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- SEÇÃO 3: RESUMO DO PERÍODO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="24dp">

                    <!-- FAIXA SUPERIOR -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_header_navy"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_doc_report_white"
                            android:contentDescription="Ícone resumo"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RESUMO DO PERÍODO"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:fontFamily="@font/manrope"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- CORPO (LISTA COM ÍCONES E DIVISORES) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_body_rounded_bottom"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <!-- ITEM 1: TOTAL DE REGISTROS -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_doc_report"
                                app:tint="@color/primary_dark"
                                android:contentDescription="Registros"
                                android:layout_marginEnd="12dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="18"
                                    android:textColor="@color/primary_dark"
                                    android:textSize="14sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Total de registros"
                                    android:textColor="@color/secondary_gray"
                                    android:textSize="11sp"
                                    android:fontFamily="@font/manrope" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E2E8F0"
                            android:layout_marginBottom="10dp" />

                        <!-- ITEM 2: REGISTROS DENTRO DA FAIXA -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_check_circle_green"
                                android:contentDescription="Dentro da faixa"
                                android:layout_marginEnd="12dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="12 (66,6%)"
                                    android:textColor="@color/primary_dark"
                                    android:textSize="14sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Registros dentro da faixa"
                                    android:textColor="@color/secondary_gray"
                                    android:textSize="11sp"
                                    android:fontFamily="@font/manrope" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E2E8F0"
                            android:layout_marginBottom="10dp" />

                        <!-- ITEM 3: REGISTROS DE ALERTA -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_alert_triangle_orange"
                                android:contentDescription="Registros alerta"
                                android:layout_marginEnd="12dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="8 (33,3%)"
                                    android:textColor="@color/primary_dark"
                                    android:textSize="14sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Registros de alerta"
                                    android:textColor="@color/secondary_gray"
                                    android:textSize="11sp"
                                    android:fontFamily="@font/manrope" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E2E8F0"
                            android:layout_marginBottom="10dp" />

                        <!-- ITEM 4: TEMPERATURA MÉDIA -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_thermometer_blue"
                                app:tint="@color/primary_dark"
                                android:contentDescription="Temperatura média"
                                android:layout_marginEnd="12dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="-2,2ºC"
                                    android:textColor="@color/primary_dark"
                                    android:textSize="14sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Temperatura média"
                                    android:textColor="@color/secondary_gray"
                                    android:textSize="11sp"
                                    android:fontFamily="@font/manrope" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E2E8F0"
                            android:layout_marginBottom="10dp" />

                        <!-- ITEM 5: MAIOR TEMPERATURA -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_arrow_up_navy"
                                android:contentDescription="Maior temperatura"
                                android:layout_marginEnd="12dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="3,5 ºC"
                                    android:textColor="@color/primary_dark"
                                    android:textSize="14sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Maior temperatura registrada"
                                    android:textColor="@color/secondary_gray"
                                    android:textSize="11sp"
                                    android:fontFamily="@font/manrope" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E2E8F0"
                            android:layout_marginBottom="10dp" />

                        <!-- ITEM 6: MENOR TEMPERATURA -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_arrow_down_navy"
                                android:contentDescription="Menor temperatura"
                                android:layout_marginEnd="12dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="-10ºC"
                                    android:textColor="@color/primary_dark"
                                    android:textSize="14sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Menor temperatura registrada"
                                    android:textColor="@color/secondary_gray"
                                    android:textSize="11sp"
                                    android:fontFamily="@font/manrope" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

                <!-- RODAPÉ DO DOCUMENTO (FOTO 3) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#CBD5E1"
                    android:layout_marginBottom="10dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="SKADI - 2026"
                        android:textColor="#64748B"
                        android:textSize="11.5sp"
                        android:fontFamily="@font/manrope"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="Página 1 de 1"
                        android:textColor="#64748B"
                        android:textSize="11.5sp"
                        android:fontFamily="@font/manrope" />
                </RelativeLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
