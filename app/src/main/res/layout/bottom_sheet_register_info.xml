<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#CBD5E1"
        android:layout_marginBottom="20dp" />

    <ImageView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/logo_skadi"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Acesso Corporativo Skadi"
        android:textColor="@color/primary_dark"
        android:textSize="19sp"
        android:fontFamily="@font/manrope"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="O cadastro de novos colaboradores e gestores é gerenciado exclusivamente pela equipe de TI e Recursos Humanos da sua unidade frigorífica.\n\nCaso ainda não possua suas credenciais ou precise de novo acesso, solicite diretamente ao seu gestor ou entre em contato com nosso suporte."
        android:textColor="@color/secondary_gray"
        android:textSize="13sp"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:lineSpacingMultiplier="1.25"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEntendiCadastro"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Entendi"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:fontFamily="@font/manrope"
        android:textStyle="bold"
        app:backgroundTint="@color/primary_dark"
        app:cornerRadius="12dp"
        android:textAllCaps="false" />

</LinearLayout>
