<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".VerifyCodeActivity">

    <!-- CABEÇALHO AZUL ESCURO ARREDONDADO -->
    <LinearLayout
        android:id="@+id/headerVerifyCode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_rounded_bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="50dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- BOTÃO VOLTAR -->
        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_notif"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_back_arrow_white"
                android:contentDescription="Voltar" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Código de verificação"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:fontFamily="@font/manrope"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Passo 2 de 3: Confirmação"
                android:textColor="#A8C4DC"
                android:textSize="12.5sp"
                android:fontFamily="@font/manrope"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/headerVerifyCode"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="36dp">

            <!-- CARD BRANCO ELEGANTE -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center_horizontal"
                        android:src="@drawable/logo_skadi"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Insira o código"
                        android:textColor="@color/primary_dark"
                        android:textSize="19sp"
                        android:fontFamily="@font/manrope"
                        android:textStyle="bold"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvEmailSentNotice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enviamos um código de 6 dígitos para o e-mail informado. Digite o código abaixo para prosseguir."
                        android:textColor="@color/secondary_gray"
                        android:textSize="13sp"
                        android:fontFamily="@font/manrope"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.2"
                        android:layout_marginBottom="24dp" />

                    <!-- CAMPO CÓDIGO -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Código recebido"
                        android:textColor="@color/primary_dark"
                        android:textSize="13.5sp"
                        android:fontFamily="@font/manrope"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false"
                        app:errorEnabled="true"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCode"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:background="@drawable/bg_input_pill"
                            android:hint="Ex: 123456"
                            android:gravity="center"
                            android:letterSpacing="0.2"
                            android:maxLength="6"
                            android:inputType="number"
                            android:textColor="@color/primary_dark"
                            android:textColorHint="@color/hint_gray"
                            android:textSize="18sp"
                            android:fontFamily="@font/manrope"
                            android:textStyle="bold" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- BOTÃO VERIFICAR CÓDIGO -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerificarCodigo"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Verificar código"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:fontFamily="@font/manrope"
                        android:textStyle="bold"
                        app:backgroundTint="@color/primary_dark"
                        app:cornerRadius="12dp"
                        android:textAllCaps="false" />

                    <!-- REENVIAR CÓDIGO -->
                    <TextView
                        android:id="@+id/tvReenviarCodigo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="20dp"
                        android:text="Não recebeu? Reenviar código"
                        android:textColor="@color/accent_blue"
                        android:textSize="13.5sp"
                        android:fontFamily="@font/manrope"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="6dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
