<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- O mapa ocupa a tela; cabeÃ§alho, aÃ§Ãµes e cartÃ£o ficam flutuando sobre ele. -->
    <com.example.mobile_skadi.MapTouchFrameLayout
        android:id="@+id/mapTouchRoot"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/mapHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <org.osmdroid.views.MapView
            android:id="@+id/osmMapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvMapUnavailable"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#EEF5FA"
            android:fontFamily="@font/manrope"
            android:gravity="center"
            android:padding="32dp"
            android:textColor="@color/primary_dark"
            android:textSize="14sp"
            android:visibility="gone" />
    </com.example.mobile_skadi.MapTouchFrameLayout>

    <LinearLayout
        android:id="@+id/mapHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_rounded_bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="42dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_circle_notif"
            android:clickable="true"
            android:contentDescription="Voltar"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_back_arrow_white" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope"
                android:text="@string/cd_map_title"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/manrope"
                android:text="@string/cd_map_subtitle"
                android:textColor="#A8C4DC"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/mapLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/mapHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvMapStatus"
        style="@style/CdMapFloatingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:maxWidth="240dp"
        android:text="@string/cd_map_loading"
        app:layout_constraintTop_toBottomOf="@id/mapHeader"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvMapNearest"
        style="@style/CdMapFloatingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:maxWidth="240dp"
        android:text="@string/cd_map_distance_missing"
        android:textColor="@color/primary_dark"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvMapStatus"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMapUnits"
        style="@style/CdMapAction"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/white"
        android:elevation="5dp"
        android:text="@string/cd_map_units"
        android:textColor="@color/primary_dark"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_building"
        app:iconTint="@color/primary_dark"
        app:layout_constraintTop_toBottomOf="@id/tvMapNearest"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/mapControls"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:elevation="6dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/mapHeader"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnMyLocation"
            style="@style/CdMapIconButton"
            android:contentDescription="@string/cd_map_location"
            android:src="@drawable/ic_location_pin" />

        <ImageButton
            android:id="@+id/btnMapType"
            style="@style/CdMapIconButton"
            android:layout_marginTop="10dp"
            android:contentDescription="@string/cd_map_type"
            android:src="@drawable/ic_map_layers" />

        <ImageButton
            android:id="@+id/btnRefreshMap"
            style="@style/CdMapIconButton"
            android:layout_marginTop="10dp"
            android:contentDescription="@string/cd_map_refresh"
            android:src="@drawable/ic_map_refresh" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCdInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp"
        app:strokeColor="#E4EBF2"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp">

            <LinearLayout
                android:id="@+id/layoutEmptySelection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="56dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMapEmptySelection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope"
                    android:gravity="center"
                    android:text="@string/cd_map_loading"
                    android:textColor="@color/primary_dark"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutSelectedCdDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSelectedCdTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/manrope"
                        android:maxLines="1"
                        android:textColor="@color/primary_dark"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSelectedCdBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/manrope"
                        android:paddingStart="9dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="4dp"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSelectedCdAddress"
                    style="@style/CdMapCardMeta"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/tvSelectedCdDistance"
                    style="@style/CdMapCardMeta"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSelectedCdTemp"
                        style="@style/CdMapMetric"
                        android:layout_width="0dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvSelectedCdCamaras"
                        style="@style/CdMapMetric"
                        android:layout_width="0dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSelectedCdAlerts"
                        style="@style/CdMapMetric"
                        android:layout_width="0dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvSelectedCdOutside"
                        style="@style/CdMapMetric"
                        android:layout_width="0dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSelectedCdUpdated"
                    style="@style/CdMapCardMeta"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvSelectedCdCoverage"
                    style="@style/CdMapCardMeta"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/secondary_gray" />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_floating_bottom_bar"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/navCamaras"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="CÃ¢maras" android:src="@drawable/ic_snowflake" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="@font/manrope" android:text="CÃ¢maras" android:textColor="@color/primary_dark" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAlertas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="Alertas" android:src="@drawable/ic_megaphone" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="@font/manrope" android:text="Alertas" android:textColor="@color/primary_dark" android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:gravity="center">
            <LinearLayout
                android:id="@+id/navInicio"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_nav_home"
                android:clickable="true"
                android:focusable="true"
                android:elevation="4dp"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="InÃ­cio" android:src="@drawable/ic_home_outline" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:fontFamily="@font/manrope" android:text="InÃ­cio" android:textColor="@color/white" android:textSize="10.5sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/navRelatorios"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="RelatÃ³rios" android:src="@drawable/ic_doc_report" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="@font/manrope" android:text="RelatÃ³rios" android:textColor="@color/primary_dark" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTrimmy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="Trimmy" android:src="@drawable/ic_sparkle_trimmy" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="@font/manrope" android:text="Trimmy" android:textColor="@color/primary_dark" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
