<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_overlay"
    android:orientation="vertical"
    android:paddingTop="24dp">

    <TextView
        android:id="@+id/tvResetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Redefinir senha"
        android:textColor="#DC2626"
        android:textSize="18sp"
        android:fontFamily="@font/manrope"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvResetMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="Tem certeza de que quer redefinir sua senha?"
        android:textColor="#475569"
        android:textSize="14sp"
        android:fontFamily="@font/manrope" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelResetPassword"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Cancelar"
            android:textColor="#64748B"
            android:textSize="14.5sp"
            android:fontFamily="@font/manrope"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#E2E8F0" />

        <TextView
            android:id="@+id/btnConfirmResetPassword"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Confirmar"
            android:textColor="#0F2851"
            android:textSize="14.5sp"
            android:fontFamily="@font/manrope"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
