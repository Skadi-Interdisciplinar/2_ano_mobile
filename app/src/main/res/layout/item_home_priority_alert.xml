<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardPriorityItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- LINHA SUPERIOR: BADGE DE GRAVIDADE + TEMPO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvPriorityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crítico"
                android:textColor="@color/alert_danger"
                android:textSize="10.5sp"
                android:fontFamily="@font/manrope"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_critical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <TextView
                android:id="@+id/tvPriorityStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pendente"
                android:textColor="#D97706"
                android:textSize="10.5sp"
                android:fontFamily="@font/manrope"
                android:textStyle="bold"
                android:background="@drawable/bg_notif_circle_yellow"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginStart="6dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvPriorityTimeElapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Há 15 min"
                android:textColor="@color/secondary_gray"
                android:textSize="11sp"
                android:fontFamily="@font/manrope" />
        </LinearLayout>

        <!-- LINHA PRINCIPAL: NOME DA CÂMARA E TEMPERATURA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvPriorityCamaraTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Câmara 291"
                android:textColor="@color/primary_dark"
                android:textSize="15sp"
                android:fontFamily="@font/manrope"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPriorityTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8,4°C"
                android:textColor="@color/alert_danger"
                android:textSize="18sp"
                android:fontFamily="@font/manrope"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- FAIXA RECOMENDADA E SITUAÇÃO DO SLA -->
        <TextView
            android:id="@+id/tvPriorityRangeAndSla"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Faixa: 0,0°C a 4,0°C • SLA: Próximo do vencimento"
            android:textColor="@color/secondary_gray"
            android:textSize="11.5sp"
            android:fontFamily="@font/manrope"
            android:layout_marginBottom="4dp" />

        <!-- RESPONSÁVEL ATRIBUÍDO -->
        <TextView
            android:id="@+id/tvPriorityAssignee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Responsável: Não atribuído"
            android:textColor="@color/secondary_dark"
            android:textSize="11sp"
            android:fontFamily="@font/manrope"
            android:textStyle="bold" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
