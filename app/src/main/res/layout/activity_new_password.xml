<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".NewPasswordActivity">

    <!-- CABEÃ‡ALHO AZUL ESCURO ARREDONDADO -->
    <LinearLayout
        android:id="@+id/headerNewPassword"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_rounded_bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="50dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- BOTÃƒO VOLTAR -->
        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_notif"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_back_arrow_white"
                android:contentDescription="Voltar" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Criar nova senha"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:fontFamily="@font/manrope"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Passo 3 de 3: FinalizaÃ§Ã£o"
                android:textColor="#A8C4DC"
                android:textSize="12.5sp"
                android:fontFamily="@font/manrope"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/headerNewPassword"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="36dp">

            <!-- CARD BRANCO ELEGANTE -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center_horizontal"
                        android:src="@drawable/logo_skadi"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Defina sua nova senha"
                        android:textColor="@color/primary_dark"
                        android:textSize="19sp"
                        android:fontFamily="@font/manrope"
                        android:textStyle="bold"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Crie uma combinaÃ§Ã£o forte e fÃ¡cil de lembrar com pelo menos 6 caracteres."
                        android:textColor="@color/secondary_gray"
                        android:textSize="13sp"
                        android:fontFamily="@font/manrope"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.2"
                        android:layout_marginBottom="24dp" />

                    <!-- NOVA SENHA -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nova senha"
                        android:textColor="@color/primary_dark"
                        android:textSize="13.5sp"
                        android:fontFamily="@font/manrope"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNovaSenha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false"
                        app:errorEnabled="true"
                        app:passwordToggleEnabled="true"
                        android:layout_marginBottom="14dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNovaSenha"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_input_pill"
                            android:hint="â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢"
                            android:inputType="textPassword"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textColor="@color/primary_dark"
                            android:textColorHint="@color/hint_gray"
                            android:textSize="14sp"
                            android:fontFamily="@font/manrope" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- CONFIRMAR SENHA -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Confirmar nova senha"
                        android:textColor="@color/primary_dark"
                        android:textSize="13.5sp"
                        android:fontFamily="@font/manrope"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilConfirmarSenha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false"
                        app:errorEnabled="true"
                        app:passwordToggleEnabled="true"
                        android:layout_marginBottom="20dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etConfirmarSenha"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_input_pill"
                            android:hint="â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢"
                            android:inputType="textPassword"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textColor="@color/primary_dark"
                            android:textColorHint="@color/hint_gray"
                            android:textSize="14sp"
                            android:fontFamily="@font/manrope" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- BOTÃƒO SALVAR NOVA SENHA -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSalvarNovaSenha"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Salvar nova senha"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:fontFamily="@font/manrope"
                        android:textStyle="bold"
                        app:backgroundTint="@color/primary_dark"
                        app:cornerRadius="12dp"
                        android:textAllCaps="false" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
