<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_dark">

    <!-- CONTAINER CENTRALIZADO FIGMA (LOGO + SKADI + SUBTÍTULO) -->
    <LinearLayout
        android:id="@+id/layoutCenterBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- LOGO SKADI EM ALTA QUALIDADE -->
        <ImageView
            android:id="@+id/ivSplashLogo"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/logo_skadi"
            android:contentDescription="Logo Skadi"
            android:scaleType="fitCenter" />

        <!-- NOME DA MARCA EM CINZEL DECORATIVE -->
        <TextView
            android:id="@+id/tvSplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SKADI"
            android:textColor="@color/white"
            android:textSize="40sp"
            android:fontFamily="@font/cinzel_decorative"
            android:letterSpacing="0.18"
            android:layout_marginTop="20dp" />

        <!-- SLOGAN / SUBTÍTULO -->
        <TextView
            android:id="@+id/tvSplashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monitoramento Térmico Inteligente"
            android:textColor="#A8C4DC"
            android:textSize="14sp"
            android:fontFamily="@font/manrope"
            android:letterSpacing="0.04"
            android:layout_marginTop="8dp" />

        <!-- SPINNER DE CARREGAMENTO SUTIL -->
        <ProgressBar
            android:id="@+id/pbSplashLoading"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:indeterminate="true"
            android:indeterminateTint="#A8C4DC"
            android:layout_marginTop="40dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
