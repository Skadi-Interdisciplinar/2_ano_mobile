<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollAlerts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="120dp">

            <!-- HEADER AZUL ESCURO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_rounded_bottom"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="50dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Central de alertas"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:fontFamily="@font/manrope"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Atualizado agora"
                        android:textColor="#A8C4DC"
                        android:textSize="12sp"
                        android:fontFamily="@font/manrope"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- BOTÃO NOTIFICAÇÃO (CIRCULAR) -->
                <FrameLayout
                    android:id="@+id/btnNotification"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_notif"
                    android:layout_marginEnd="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bell_rounded"
                        android:contentDescription="Notificações" />
                </FrameLayout>

                <!-- AVATAR CIRCULAR -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnProfileAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/white">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/logo_skadi"
                        android:background="@color/primary_light"
                        android:scaleType="centerInside"
                        android:padding="4dp"
                        android:contentDescription="Perfil" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- CORPO DA TELA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp">

                <!-- CARDS RESUMO (3 COLUNAS: ATIVOS, CRITICOS, RESOLVIDO) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">

                    <!-- Ativos -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E2E8F0"
                        android:layout_marginEnd="5dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3"
                                android:textColor="@color/alert_orange"
                                android:textSize="24sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ativos"
                                android:textColor="@color/secondary_gray"
                                android:textSize="11sp"
                                android:fontFamily="@font/manrope"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Críticos -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E2E8F0"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1"
                                android:textColor="@color/alert_danger"
                                android:textSize="24sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Críticos"
                                android:textColor="@color/secondary_gray"
                                android:textSize="11sp"
                                android:fontFamily="@font/manrope"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Resolvido -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E2E8F0"
                        android:layout_marginStart="5dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1"
                                android:textColor="@color/alert_success"
                                android:textSize="24sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Resolvido"
                                android:textColor="@color/secondary_gray"
                                android:textSize="11sp"
                                android:fontFamily="@font/manrope"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- LISTA DE CARDS DE ALERTA -->
                <!-- 1. CARD CRÍTICO (CÂMARA 291) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAlertCritical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- FAIXA LATERAL VERMELHA -->
                        <View
                            android:layout_width="6dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_strip_critical" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="20dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp">

                            <!-- LINHA SUPERIOR: BADGE + HORA + TEMPERATURA -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="● Crítico"
                                    android:textColor="@color/alert_danger"
                                    android:textSize="11sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold"
                                    android:background="@drawable/bg_badge_critical"
                                    android:paddingStart="10dp"
                                    android:paddingEnd="10dp"
                                    android:paddingTop="3dp"
                                    android:paddingBottom="3dp" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="11h11"
                                    android:textColor="@color/secondary_gray"
                                    android:textSize="12sp"
                                    android:fontFamily="@font/manrope"
                                    android:layout_marginStart="8dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="8,4°C"
                                    android:textColor="@color/alert_danger"
                                    android:textSize="22sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Câmara 291"
                                android:textColor="@color/primary_dark"
                                android:textSize="17sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold"
                                android:layout_marginBottom="4dp" />

                            <!-- LINHA INFERIOR: MIN/MAX + CHEVRON -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Mín. 0°C | Máx. 4°C"
                                    android:textColor="@color/secondary_gray"
                                    android:textSize="12sp"
                                    android:fontFamily="@font/manrope" />

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_chevron_right"
                                    android:contentDescription="Ver detalhes" />
                            </LinearLayout>
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. CARD ATENÇÃO (CÂMARA 61) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAlertWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- FAIXA LATERAL AMARELA -->
                        <View
                            android:layout_width="6dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_strip_warning" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="20dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp">

                            <!-- LINHA SUPERIOR -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="● Atenção"
                                    android:textColor="#E5A100"
                                    android:textSize="11sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold"
                                    android:background="@drawable/bg_badge_warning"
                                    android:paddingStart="10dp"
                                    android:paddingEnd="10dp"
                                    android:paddingTop="3dp"
                                    android:paddingBottom="3dp" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="9h56"
                                    android:textColor="@color/secondary_gray"
                                    android:textSize="12sp"
                                    android:fontFamily="@font/manrope"
                                    android:layout_marginStart="8dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="2,3°C"
                                    android:textColor="#E5A100"
                                    android:textSize="22sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Câmara 61"
                                android:textColor="@color/primary_dark"
                                android:textSize="17sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold"
                                android:layout_marginBottom="4dp" />

                            <!-- LINHA INFERIOR -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Mín. 0°C | Máx. 2°C"
                                    android:textColor="@color/secondary_gray"
                                    android:textSize="12sp"
                                    android:fontFamily="@font/manrope" />

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_chevron_right"
                                    android:contentDescription="Ver detalhes" />
                            </LinearLayout>
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. CARD ESTÁVEL (CÂMARA 1) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAlertStable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0"
                    android:layout_marginBottom="32dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- FAIXA LATERAL VERDE -->
                        <View
                            android:layout_width="6dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_strip_stable" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="20dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp">

                            <!-- LINHA SUPERIOR -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="● Estável"
                                    android:textColor="@color/alert_success"
                                    android:textSize="11sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold"
                                    android:background="@drawable/bg_badge_stable"
                                    android:paddingStart="10dp"
                                    android:paddingEnd="10dp"
                                    android:paddingTop="3dp"
                                    android:paddingBottom="3dp" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="5h12"
                                    android:textColor="@color/secondary_gray"
                                    android:textSize="12sp"
                                    android:fontFamily="@font/manrope"
                                    android:layout_marginStart="8dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="1,4°C"
                                    android:textColor="@color/alert_success"
                                    android:textSize="22sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Câmara 1"
                                android:textColor="@color/primary_dark"
                                android:textSize="17sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold"
                                android:layout_marginBottom="4dp" />

                            <!-- LINHA INFERIOR -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Mín. 0°C | Máx. 4°C"
                                    android:textColor="@color/secondary_gray"
                                    android:textSize="12sp"
                                    android:fontFamily="@font/manrope" />

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_chevron_right"
                                    android:contentDescription="Ver detalhes" />
                            </LinearLayout>
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- LINK DO RODAPÉ -->
                <TextView
                    android:id="@+id/btnEntendaNiveis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Entenda os níveis de alerta"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:fontFamily="@font/manrope"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- TOOLBAR FLUTUANTE EM PÍLULA (COM ALERTAS EM DESTAQUE NO CÍRCULO - FOTO ENVIADA) -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_floating_bottom_bar"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 1. Câmaras -->
        <LinearLayout
            android:id="@+id/navCamaras"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_snowflake"
                android:contentDescription="Câmaras" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Câmaras"
                android:textColor="@color/primary_dark"
                android:textSize="11sp"
                android:fontFamily="@font/manrope"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- 2. Alertas (ABA ATIVA COM CÍRCULO AZUL MARINHO - FOTO ENVIADA) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/navAlertas"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_circle_nav_home"
                android:elevation="4dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_megaphone_white"
                    android:contentDescription="Alertas" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alertas"
                    android:textColor="@color/white"
                    android:textSize="10.5sp"
                    android:fontFamily="@font/manrope"
                    android:layout_marginTop="1dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- 3. Início -->
        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home_navy"
                android:contentDescription="Início" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Início"
                android:textColor="@color/primary_dark"
                android:textSize="11sp"
                android:fontFamily="@font/manrope"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- 4. Relatórios -->
        <LinearLayout
            android:id="@+id/navRelatorios"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_doc_report"
                android:contentDescription="Relatórios" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Relatórios"
                android:textColor="@color/primary_dark"
                android:textSize="11sp"
                android:fontFamily="@font/manrope"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- 5. Trimmy (IA) -->
        <LinearLayout
            android:id="@+id/navTrimmy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_sparkle_trimmy"
                android:contentDescription="Trimmy" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trimmy"
                android:textColor="@color/primary_dark"
                android:textSize="11sp"
                android:fontFamily="@font/manrope"
                android:layout_marginTop="3dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
