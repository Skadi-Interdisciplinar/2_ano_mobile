<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- CONTEÚDO COM ROLAGEM -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollCamaraDetails"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="120dp">

            <!-- CABEÇALHO AZUL ESCURO ARREDONDADO COM VOLTAR E BADGE DE STATUS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_rounded_bottom"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="50dp"
                android:paddingBottom="24dp">

                <!-- BOTÃO VOLTAR -->
                <FrameLayout
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_notif"
                    android:layout_marginEnd="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_back_arrow_white"
                        android:contentDescription="Voltar" />
                </FrameLayout>

                <!-- TÍTULO E SUBTÍTULO -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCamaraTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Câmara 291"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:fontFamily="@font/manrope"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCamaraSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Frigorífico Belterra"
                        android:textColor="#A8C4DC"
                        android:textSize="12.5sp"
                        android:fontFamily="@font/manrope"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- BADGE DE STATUS (ESTÁVEL / CRÍTICO) -->
                <TextView
                    android:id="@+id/tvCamaraStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Estável"
                    android:textColor="@color/alert_success"
                    android:textSize="11.5sp"
                    android:fontFamily="@font/manrope"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge_stable"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />
            </LinearLayout>

            <!-- CORPO DA TELA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp">

                <!-- SEÇÃO 1: TEMPERATURA ATUAL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Temperatura atual"
                    android:textColor="@color/primary_dark"
                    android:textSize="14sp"
                    android:fontFamily="@font/manrope"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <!-- CARD TEMPERATURA ATUAL + FAIXA DE OPERAÇÃO -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <!-- ÍCONE DE TERMÔMETRO EM CÍRCULO AZUL CLARO -->
                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_circle_light_blue"
                            android:layout_marginEnd="12dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_thermometer_blue"
                                android:contentDescription="Temperatura atual" />
                        </FrameLayout>

                        <!-- VALOR ATUAL -->
                        <TextView
                            android:id="@+id/tvCurrentTemp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="2,0°C"
                            android:textColor="@color/primary_dark"
                            android:textSize="28sp"
                            android:fontFamily="@font/manrope"
                            android:textStyle="bold" />

                        <!-- BOX FAIXA DE OPERAÇÃO -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_metric_blue_card"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Faixa de operação"
                                android:textColor="#1E3A5F"
                                android:textSize="11sp"
                                android:fontFamily="@font/manrope" />

                            <TextView
                                android:id="@+id/tvTempRange"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0°C — 4°C"
                                android:textColor="@color/primary_dark"
                                android:textSize="14sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- SEÇÃO 2: TEMPERATURA NAS ÚLTIMAS 24 HORAS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Temperatura nas últimas 24 horas"
                    android:textColor="@color/primary_dark"
                    android:textSize="14sp"
                    android:fontFamily="@font/manrope"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <!-- CARD FAIXA IDEAL (3 CAIXAS AZUIS) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- CABEÇALHO DO CARD FAIXA IDEAL -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="14dp">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_circle_light_blue"
                                android:layout_marginEnd="10dp">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_thermometer_blue"
                                    android:contentDescription="Faixa ideal" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Faixa ideal"
                                android:textColor="@color/primary_dark"
                                android:textSize="14sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- 3 BOXES DE MÉTRICAS (MÍNIMA, MÉDIA, MÁXIMA) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- MÍNIMA -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_metric_blue_card"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:paddingTop="12dp"
                                android:paddingBottom="12dp"
                                android:layout_marginEnd="5dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="-2°C"
                                    android:textColor="@color/primary_dark"
                                    android:textSize="18sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Mínima"
                                    android:textColor="#1E3A5F"
                                    android:textSize="11sp"
                                    android:fontFamily="@font/manrope"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <!-- MÉDIA -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_metric_blue_card"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:paddingTop="12dp"
                                android:paddingBottom="12dp"
                                android:layout_marginStart="5dp"
                                android:layout_marginEnd="5dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="2,0°C"
                                    android:textColor="@color/primary_dark"
                                    android:textSize="18sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Média"
                                    android:textColor="#1E3A5F"
                                    android:textSize="11sp"
                                    android:fontFamily="@font/manrope"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <!-- MÁXIMA -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_metric_blue_card"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:paddingTop="12dp"
                                android:paddingBottom="12dp"
                                android:layout_marginStart="5dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="3,2°C"
                                    android:textColor="@color/primary_dark"
                                    android:textSize="18sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Máxima"
                                    android:textColor="#1E3A5F"
                                    android:textSize="11sp"
                                    android:fontFamily="@font/manrope"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- CARD DO GRÁFICO DE TEMPERATURA COM INDICADORES NO TOPO -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- 3 COLUNAS DE RESUMO NO TOPO DO GRÁFICO -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <!-- MÍNIMA REGISTRADA -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="-2,0 °C"
                                    android:textColor="#2563EB"
                                    android:textSize="15sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Mínima registrada"
                                    android:textColor="@color/secondary_gray"
                                    android:textSize="10sp"
                                    android:fontFamily="@font/manrope"
                                    android:gravity="center"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <!-- MÉDIA DO PERÍODO -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="2,0 °C"
                                    android:textColor="@color/primary_dark"
                                    android:textSize="15sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Média do período"
                                    android:textColor="@color/secondary_gray"
                                    android:textSize="10sp"
                                    android:fontFamily="@font/manrope"
                                    android:gravity="center"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <!-- MÁXIMA REGISTRADA -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="3,2 °C"
                                    android:textColor="@color/alert_danger"
                                    android:textSize="15sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Máxima registrada"
                                    android:textColor="@color/secondary_gray"
                                    android:textSize="10sp"
                                    android:fontFamily="@font/manrope"
                                    android:gravity="center"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- GRÁFICO DE TEMPERATURA -->
                        <com.example.mobile_skadi.TemperatureChartView
                            android:id="@+id/chartCamaraDetails"
                            android:layout_width="match_parent"
                            android:layout_height="170dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- SEÇÃO 3: CARD STATUS DA CÂMARA (VERDE SUAVE) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_card_green"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <!-- CABEÇALHO STATUS DA CÂMARA -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_check_circle_green"
                            android:contentDescription="Status"
                            android:layout_marginEnd="10dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Status da câmara"
                                android:textColor="#065F46"
                                android:textSize="14sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Monitoramento em tempo real dos parâmetros"
                                android:textColor="#047857"
                                android:textSize="11sp"
                                android:fontFamily="@font/manrope"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 4 MINI-BOXES DE PARÂMETROS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- MÍNIMA -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_status_mini_box_green"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:layout_marginEnd="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mínima"
                                android:textColor="#047857"
                                android:textSize="10sp"
                                android:fontFamily="@font/manrope" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0,0°C"
                                android:textColor="#065F46"
                                android:textSize="13sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- ATUAL -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_status_mini_box_green"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Atual"
                                android:textColor="#047857"
                                android:textSize="10sp"
                                android:fontFamily="@font/manrope" />

                            <TextView
                                android:id="@+id/tvStatusBoxCurrent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2,0°C"
                                android:textColor="#065F46"
                                android:textSize="13sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- MÉDIA -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_status_mini_box_green"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Média"
                                android:textColor="#047857"
                                android:textSize="10sp"
                                android:fontFamily="@font/manrope" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1,9°C"
                                android:textColor="#065F46"
                                android:textSize="13sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- MÁXIMA -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_status_mini_box_green"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:layout_marginStart="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Máxima"
                                android:textColor="#047857"
                                android:textSize="10sp"
                                android:fontFamily="@font/manrope" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4,0°C"
                                android:textColor="#065F46"
                                android:textSize="13sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- TOOLBAR FLUTUANTE EM PÍLULA COM CÂMARAS ATIVA -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_floating_bottom_bar"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 1. Câmaras (ABA ATIVA COM CÍRCULO AZUL MARINHO) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/navCamaras"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_circle_nav_home"
                android:elevation="4dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_snowflake_white"
                    android:contentDescription="Câmaras" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Câmaras"
                    android:textColor="@color/white"
                    android:textSize="10.5sp"
                    android:fontFamily="@font/manrope"
                    android:layout_marginTop="1dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- 2. Alertas -->
        <LinearLayout
            android:id="@+id/navAlertas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_megaphone"
                android:contentDescription="Alertas" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alertas"
                android:textColor="@color/primary_dark"
                android:textSize="11sp"
                android:fontFamily="@font/manrope"
