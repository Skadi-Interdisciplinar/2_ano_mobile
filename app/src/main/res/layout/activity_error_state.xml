<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="24dp">

    <!-- BOTÃO VOLTAR SUPERIOR ESQUERDO (EXIBIDO EM ALGO DEU ERRADO / 404) -->
    <LinearLayout
        android:id="@+id/btnBackTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_circle_nav_home">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_back_arrow_white"
                android:contentDescription="Voltar" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Voltar"
            android:textColor="@color/primary_dark"
            android:textSize="13sp"
            android:fontFamily="@font/manrope"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- CONTEÚDO CENTRAL (ÍCONE + TÍTULO + DESCRIÇÃO) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivErrorIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_error_wifi_off"
            android:contentDescription="Estado de erro"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvErrorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conecte-se à internet"
            android:textColor="@color/primary_dark"
            android:textSize="18sp"
            android:fontFamily="@font/manrope"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvErrorDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Você está offline. Verifique sua conexão e tente novamente."
            android:textColor="@color/secondary_gray"
            android:textSize="13sp"
            android:fontFamily="@font/manrope"
            android:gravity="center" />
    </LinearLayout>

    <!-- BOTÃO TENTAR NOVAMENTE NO RODAPÉ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRetryError"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginBottom="16dp"
        android:text="Tentar novamente"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:fontFamily="@font/manrope"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:backgroundTint="@color/primary_dark"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
