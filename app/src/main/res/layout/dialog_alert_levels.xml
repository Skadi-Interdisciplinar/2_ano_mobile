<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="36dp">

    <!-- CABEÇALHO COM BOTÃO X E TÍTULO -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp">

        <FrameLayout
            android:id="@+id/btnCloseDialog"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_close"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close_gray"
                android:contentDescription="Fechar" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Níveis de alerta"
            android:textColor="@color/primary_dark"
            android:textSize="20sp"
            android:fontFamily="@font/manrope"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- NÍVEL 1: ESTÁVEL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginBottom="24dp">

        <!-- Ícone quadrado arredondado verde -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_square_green"
            android:layout_marginEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check_circle_green"
                android:contentDescription="Estável" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estável"
                android:textColor="@color/alert_success"
                android:textSize="18sp"
                android:fontFamily="@font/manrope"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dentro do padrão"
                android:textColor="@color/secondary_dark"
                android:textSize="13sp"
                android:fontFamily="@font/manrope"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Não é necessário nenhuma ação no momento."
                android:textColor="@color/secondary_gray"
                android:textSize="12sp"
                android:fontFamily="@font/manrope"
                android:lineSpacingMultiplier="1.1" />
        </LinearLayout>
    </LinearLayout>

    <!-- NÍVEL 2: ATENÇÃO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginBottom="24dp">

        <!-- Ícone quadrado arredondado amarelo -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_square_yellow"
            android:layout_marginEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_eye_warning"
                android:contentDescription="Atenção" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Atenção"
                android:textColor="#E5A100"
                android:textSize="18sp"
                android:fontFamily="@font/manrope"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pequena alteração, fique de olho"
                android:textColor="@color/secondary_dark"
                android:textSize="13sp"
                android:fontFamily="@font/manrope"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Acompanhe durante alguns minutos."
                android:textColor="@color/secondary_gray"
                android:textSize="12sp"
                android:fontFamily="@font/manrope"
                android:lineSpacingMultiplier="1.1" />
        </LinearLayout>
    </LinearLayout>

    <!-- NÍVEL 3: CRÍTICO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <!-- Ícone quadrado arredondado vermelho -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_square_red"
            android:layout_marginEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_alert_triangle_red"
                android:contentDescription="Crítico" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crítico"
                android:textColor="@color/alert_orange"
                android:textSize="18sp"
                android:fontFamily="@font/manrope"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Temperatura fora do padrão"
                android:textColor="@color/secondary_dark"
                android:textSize="13sp"
                android:fontFamily="@font/manrope"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verifique porta, carga e sistema de refrigeração"
                android:textColor="@color/secondary_gray"
                android:textSize="12sp"
                android:fontFamily="@font/manrope"
                android:lineSpacingMultiplier="1.1" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
