<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="36dp">

    <!-- CABEÇALHO COM BOTÃO FECHAR E TÍTULO -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <FrameLayout
            android:id="@+id/btnCloseDialog"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_close"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close_gray"
                android:contentDescription="Fechar" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Níveis de Alerta"
            android:textColor="@color/primary_dark"
            android:textSize="20sp"
            android:fontFamily="@font/manrope"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- NÍVEL 1: ESTÁVEL / BAIXA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginBottom="20dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_square_green"
            android:layout_marginEnd="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check_circle_green"
                android:contentDescription="Estável" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estável / Baixa"
                android:textColor="@color/alert_success"
                android:textSize="16sp"
                android:fontFamily="@font/manrope"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dentro da faixa de operação • Operador"
                android:textColor="@color/secondary_dark"
                android:textSize="12.5sp"
                android:fontFamily="@font/manrope"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nenhuma ação imediata necessária. Monitoramento contínuo padrão."
                android:textColor="@color/secondary_gray"
                android:textSize="12sp"
                android:fontFamily="@font/manrope"
                android:lineSpacingMultiplier="1.1" />
        </LinearLayout>
    </LinearLayout>

    <!-- NÍVEL 2: ATENÇÃO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginBottom="20dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_square_yellow"
            android:layout_marginEnd="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_eye_warning"
                android:contentDescription="Atenção" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Atenção"
                android:textColor="#E5A100"
                android:textSize="16sp"
                android:fontFamily="@font/manrope"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Variação preventiva • Operador / Gestor"
                android:textColor="@color/secondary_dark"
                android:textSize="12.5sp"
                android:fontFamily="@font/manrope"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pequena oscilação registrada. Recomenda-se acompanhar preventivamente."
                android:textColor="@color/secondary_gray"
                android:textSize="12sp"
                android:fontFamily="@font/manrope"
                android:lineSpacingMultiplier="1.1" />
        </LinearLayout>
    </LinearLayout>

    <!-- NÍVEL 3: URGENTE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginBottom="20dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_notif_circle_yellow"
            android:layout_marginEnd="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_alert_triangle_orange"
                android:contentDescription="Urgente" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Urgente"
                android:textColor="#D97706"
                android:textSize="16sp"
                android:fontFamily="@font/manrope"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Risco à vida útil da carga • Gestor CD"
                android:textColor="@color/secondary_dark"
                android:textSize="12.5sp"
                android:fontFamily="@font/manrope"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Oscilação relevante detectada. Exige verificação das portas e compressores."
                android:textColor="@color/secondary_gray"
                android:textSize="12sp"
                android:fontFamily="@font/manrope"
                android:lineSpacingMultiplier="1.1" />
        </LinearLayout>
    </LinearLayout>

    <!-- NÍVEL 4: CRÍTICO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_square_red"
            android:layout_marginEnd="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_alert_triangle_red"
                android:contentDescription="Crítico" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crítico"
                android:textColor="@color/alert_danger"
                android:textSize="16sp"
                android:fontFamily="@font/manrope"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Violação ANVISA RDC 216 • Gestor e Admin"
                android:textColor="@color/secondary_dark"
                android:textSize="12.5sp"
                android:fontFamily="@font/manrope"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Temperatura fora do limite aceitável. Acionamento emergencial de manutenção."
                android:textColor="@color/secondary_gray"
                android:textSize="12sp"
                android:fontFamily="@font/manrope"
                android:lineSpacingMultiplier="1.1" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
