<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- CONTEÚDO COM ROLAGEM -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollFullAnalysis"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="120dp">

            <!-- CABEÇALHO AZUL ESCURO COM BOTÃO VOLTAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_rounded_bottom"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="50dp"
                android:paddingBottom="24dp">

                <!-- BOTÃO VOLTAR (CIRCULAR) -->
                <FrameLayout
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_notif"
                    android:layout_marginEnd="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_back_arrow_white"
                        android:contentDescription="Voltar" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Análise Completa"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:fontFamily="@font/manrope"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unidade Belterra"
                        android:textColor="#A8C4DC"
                        android:textSize="12sp"
                        android:fontFamily="@font/manrope"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- BOTÃO NOTIFICAÇÃO -->
                <FrameLayout
                    android:id="@+id/btnNotification"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_notif"
                    android:layout_marginEnd="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bell_rounded"
                        android:contentDescription="Notificações" />
                </FrameLayout>

                <!-- AVATAR -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnProfileAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/white">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/logo_skadi"
                        android:background="@color/primary_light"
                        android:scaleType="centerInside"
                        android:padding="4dp"
                        android:contentDescription="Perfil" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- CORPO DA TELA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp">

                <!-- CARD 1: FILTROS DO RELATÓRIO -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Centro de distribuição"
                            android:textColor="@color/primary_dark"
                            android:textSize="13sp"
                            android:fontFamily="@font/manrope"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_input_pill"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="Belterra"
                            android:textColor="@color/primary_dark"
                            android:textSize="14sp"
                            android:fontFamily="@font/manrope"
                            android:layout_marginBottom="14dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Câmara"
                            android:textColor="@color/primary_dark"
                            android:textSize="13sp"
                            android:fontFamily="@font/manrope"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_input_pill"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="Todos"
                            android:textColor="@color/primary_dark"
                            android:textSize="14sp"
                            android:fontFamily="@font/manrope"
                            android:layout_marginBottom="14dp" />

                        <!-- DATAS -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Data inicial"
                                    android:textColor="@color/primary_dark"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold"
                                    android:layout_marginBottom="6dp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="44dp"
                                    android:background="@drawable/bg_input_pill"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="11/08/2026"
                                        android:textColor="@color/primary_dark"
                                        android:textSize="13sp"
                                        android:fontFamily="@font/manrope" />

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:src="@drawable/ic_calendar"
                                        android:contentDescription="Data" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Data final"
                                    android:textColor="@color/primary_dark"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold"
                                    android:layout_marginBottom="6dp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="44dp"
                                    android:background="@drawable/bg_input_pill"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="15/08/2026"
                                        android:textColor="@color/primary_dark"
                                        android:textSize="13sp"
                                        android:fontFamily="@font/manrope" />

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:src="@drawable/ic_calendar"
                                        android:contentDescription="Data" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- CARD 2: CENTRO DE DISTRIBUIÇÃO BELTERRA (MÉTRICAS) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Centro de Distribuição Belterra"
                            android:textColor="@color/primary_dark"
                            android:textSize="15sp"
                            android:fontFamily="@font/manrope"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Relatório de temperatura · Todas as câmaras"
                            android:textColor="@color/secondary_gray"
                            android:textSize="11.5sp"
                            android:fontFamily="@font/manrope"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="12dp" />

                        <!-- LINHA DIVISÓRIA -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E2E8F0"
                            android:layout_marginBottom="14dp" />

                        <!-- 3 CARDS DE MÉTRICAS -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- MÉTRICA 1: MÍNIMA -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_metric_blue_card"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:paddingTop="12dp"
                                android:paddingBottom="12dp"
                                android:layout_marginEnd="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="-2°"
                                    android:textColor="@color/primary_dark"
                                    android:textSize="20sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Mínima"
                                    android:textColor="#1E3A5F"
                                    android:textSize="11sp"
                                    android:fontFamily="@font/manrope"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <!-- MÉTRICA 2: MÉDIA -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_metric_blue_card"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:paddingTop="12dp"
                                android:paddingBottom="12dp"
                                android:layout_marginStart="4dp"
                                android:layout_marginEnd="4dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="2.0"
                                    android:textColor="@color/primary_dark"
                                    android:textSize="20sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Média"
                                    android:textColor="#1E3A5F"
                                    android:textSize="11sp"
                                    android:fontFamily="@font/manrope"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <!-- MÉTRICA 3: MÁXIMA -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_metric_blue_card"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:paddingTop="12dp"
                                android:paddingBottom="12dp"
                                android:layout_marginStart="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="3.2°"
                                    android:textColor="@color/primary_dark"
                                    android:textSize="20sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Máxima"
                                    android:textColor="#1E3A5F"
                                    android:textSize="11sp"
                                    android:fontFamily="@font/manrope"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- CARD 3: RESUMO DAS ÚLTIMAS OCORRÊNCIAS -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resumo das últimas ocorrências"
                            android:textColor="@color/primary_dark"
                            android:textSize="15sp"
                            android:fontFamily="@font/manrope"
                            android:textStyle="bold"
                            android:layout_marginBottom="14dp" />

                        <!-- OCORRÊNCIA 1 -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Câmara 291 atingiu 3,2 ºC"
                                    android:textColor="@color/primary_dark"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="15/08 · 22:14"
                                    android:textColor="@color/secondary_gray"
                                    android:textSize="11.5sp"
                                    android:fontFamily="@font/manrope"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:text="● Crítico"
                                android:textColor="@color/alert_danger"
                                android:textSize="11sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold"
                                android:background="@drawable/bg_badge_critical"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp" />
                        </RelativeLayout>

                        <!-- OCORRÊNCIA 2 -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Câmara 67 atingiu 2,7 ºC"
                                    android:textColor="@color/primary_dark"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="14/08 · 16:51"
                                    android:textColor="@color/secondary_gray"
                                    android:textSize="11.5sp"
                                    android:fontFamily="@font/manrope"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:text="● Crítico"
                                android:textColor="#E65100"
                                android:textSize="11sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold"
                                android:background="@drawable/bg_badge_warning"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp" />
                        </RelativeLayout>

                        <!-- OCORRÊNCIA 3 -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Câmara 3 atingiu 2.0 ºC"
                                    android:textColor="@color/primary_dark"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="12/08 · 11:11"
                                    android:textColor="@color/secondary_gray"
                                    android:textSize="11.5sp"
                                    android:fontFamily="@font/manrope"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:text="● Crítico"
                                android:textColor="#D97706"
                                android:textSize="11sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold"
                                android:background="@drawable/bg_badge_warning"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp" />
                        </RelativeLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- BOTÃO BAIXAR PDF -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBaixarPdf"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Baixar PDF"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:fontFamily="@font/manrope"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_download"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:backgroundTint="@color/primary_dark"
                    app:cornerRadius="12dp"
                    android:textAllCaps="false"
                    android:layout_marginBottom="16dp" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- TOOLBAR FLUTUANTE EM PÍLULA -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_floating_bottom_bar"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 1. Câmaras -->
        <LinearLayout
            android:id="@+id/navCamaras"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_snowflake"
                android:contentDescription="Câmaras" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Câmaras"
                android:textColor="@color/primary_dark"
                android:textSize="11sp"
                android:fontFamily="@font/manrope"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- 2. Alertas -->
        <LinearLayout
            android:id="@+id/navAlertas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_megaphone"
                android:contentDescription="Alertas" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alertas"
                android:textColor="@color/primary_dark"
                android:textSize="11sp"
                android:fontFamily="@font/manrope"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- 3. Início -->
        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home_navy"
                android:contentDescription="Início" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Início"
                android:textColor="@color/primary_dark"
                android:textSize="11sp"
                android:fontFamily="@font/manrope"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- 4. Relatórios -->
        <LinearLayout
            android:id="@+id/navRelatorios"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_doc_report"
                android:contentDescription="Relatórios" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Relatórios"
                android:textColor="@color/primary_dark"
                android:textSize="11sp"
                android:fontFamily="@font/manrope"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- 5. Trimmy (IA) -->
        <LinearLayout
            android:id="@+id/navTrimmy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_sparkle_trimmy"
                android:contentDescription="Trimmy" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trimmy"
                android:textColor="@color/primary_dark"
                android:textSize="11sp"
                android:fontFamily="@font/manrope"
                android:layout_marginTop="3dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
