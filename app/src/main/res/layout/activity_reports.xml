<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- CONTEÚDO COM ROLAGEM -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollReports"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="120dp">

            <!-- CABEÇALHO AZUL ESCURO ARREDONDADO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_rounded_bottom"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="50dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Relatórios"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:fontFamily="@font/manrope"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Histórico e ocorrências"
                        android:textColor="#A8C4DC"
                        android:textSize="13sp"
                        android:fontFamily="@font/manrope"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- BOTÃO NOTIFICAÇÃO (CIRCULAR) -->
                <FrameLayout
                    android:id="@+id/btnNotification"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_notif"
                    android:layout_marginEnd="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bell_rounded"
                        android:contentDescription="Notificações" />
                </FrameLayout>

                <!-- AVATAR DO USUÁRIO -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnProfileAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/white">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/logo_skadi"
                        android:background="@color/primary_light"
                        android:scaleType="centerInside"
                        android:padding="4dp"
                        android:contentDescription="Perfil" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- CORPO DA TELA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp">

                <!-- CARD 1: FILTROS DO RELATÓRIO -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- CENTRO DE DISTRIBUIÇÃO -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Centro de distribuição"
                            android:textColor="@color/primary_dark"
                            android:textSize="13sp"
                            android:fontFamily="@font/manrope"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:id="@+id/tvCentroDistribuicao"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_input_pill"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="Belterra"
                            android:textColor="@color/primary_dark"
                            android:textSize="14sp"
                            android:fontFamily="@font/manrope"
                            android:layout_marginBottom="14dp" />

                        <!-- CÂMARA -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Câmara"
                            android:textColor="@color/primary_dark"
                            android:textSize="13sp"
                            android:fontFamily="@font/manrope"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <LinearLayout
                            android:id="@+id/spnCamara"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_input_pill"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginBottom="14dp">

                            <TextView
                                android:id="@+id/tvSelectedCamara"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Todos"
                                android:textColor="@color/primary_dark"
                                android:textSize="14sp"
                                android:fontFamily="@font/manrope" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_chevron_down"
                                android:contentDescription="Selecionar câmara" />
                        </LinearLayout>

                        <!-- DATA INICIAL E DATA FINAL (LADO A LADO) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- DATA INICIAL -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Data inicial"
                                    android:textColor="@color/primary_dark"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold"
                                    android:layout_marginBottom="6dp" />

                                <LinearLayout
                                    android:id="@+id/btnDataInicial"
                                    android:layout_width="match_parent"
                                    android:layout_height="44dp"
                                    android:background="@drawable/bg_input_pill"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp"
                                    android:clickable="true"
                                    android:focusable="true">

                                    <TextView
                                        android:id="@+id/tvDataInicial"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="11/08/2026"
                                        android:textColor="@color/primary_dark"
                                        android:textSize="13sp"
                                        android:fontFamily="@font/manrope" />

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:src="@drawable/ic_calendar"
                                        android:contentDescription="Data inicial" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- DATA FINAL -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Data final"
                                    android:textColor="@color/primary_dark"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold"
                                    android:layout_marginBottom="6dp" />

                                <LinearLayout
                                    android:id="@+id/btnDataFinal"
                                    android:layout_width="match_parent"
                                    android:layout_height="44dp"
                                    android:background="@drawable/bg_input_pill"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp"
                                    android:clickable="true"
                                    android:focusable="true">

                                    <TextView
                                        android:id="@+id/tvDataFinal"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="15/08/2026"
                                        android:textColor="@color/primary_dark"
                                        android:textSize="13sp"
                                        android:fontFamily="@font/manrope" />

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:src="@drawable/ic_calendar"
                                        android:contentDescription="Data final" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- CARD 2: ÚLTIMOS ALERTAS GERAIS -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- CABEÇALHO DO CARD COM BOTÃO ORDENAR -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:text="Últimos alertas gerais"
                                android:textColor="@color/primary_dark"
                                android:textSize="15sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/btnOrdenar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:text="Ordenar"
                                android:textColor="#2563EB"
                                android:textSize="13sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold"
                                android:clickable="true"
                                android:focusable="true" />
                        </RelativeLayout>

                        <!-- ITEM 1: CÂMARA 291 -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Câmara 291 atingiu 3,4 ºC"
                                    android:textColor="@color/primary_dark"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="15/08 · 22:14"
                                    android:textColor="@color/secondary_gray"
                                    android:textSize="11.5sp"
                                    android:fontFamily="@font/manrope"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:text="● Crítico"
                                android:textColor="@color/alert_danger"
                                android:textSize="11sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold"
                                android:background="@drawable/bg_badge_critical"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp" />
                        </RelativeLayout>

                        <!-- ITEM 2: CÂMARA 67 -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Câmara 67 atingiu 2,7 ºC"
                                    android:textColor="@color/primary_dark"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="14/08 · 16:51"
                                    android:textColor="@color/secondary_gray"
                                    android:textSize="11.5sp"
                                    android:fontFamily="@font/manrope"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:text="● Crítico"
                                android:textColor="#E65100"
                                android:textSize="11sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold"
                                android:background="@drawable/bg_badge_warning"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp" />
                        </RelativeLayout>

                        <!-- ITEM 3: CÂMARA 03 -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Câmara 03 atingiu 1,8 ºC"
                                    android:textColor="@color/primary_dark"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="12/08 · 11:11"
                                    android:textColor="@color/secondary_gray"
                                    android:textSize="11.5sp"
                                    android:fontFamily="@font/manrope"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:text="● Crítico"
                                android:textColor="#D97706"
                                android:textSize="11sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold"
                                android:background="@drawable/bg_badge_warning"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp" />
                        </RelativeLayout>

                        <!-- ITEM 4: CÂMARA 521 -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Câmara 521 atingiu 3,5 ºC"
                                    android:textColor="@color/primary_dark"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="15/08 · 15:48"
                                    android:textColor="@color/secondary_gray"
                                    android:textSize="11.5sp"
                                    android:fontFamily="@font/manrope"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:text="● Crítico"
                                android:textColor="@color/alert_danger"
                                android:textSize="11sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold"
                                android:background="@drawable/bg_badge_critical"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp" />
                        </RelativeLayout>

                        <!-- ITEM 5: CÂMARA 67 -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Câmara 67 atingiu 2.2 ºC"
                                    android:textColor="@color/primary_dark"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="14/08 · 17:57"
                                    android:textColor="@color/secondary_gray"
                                    android:textSize="11.5sp"
                                    android:fontFamily="@font/manrope"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:text="● Crítico"
                                android:textColor="#E65100"
                                android:textSize="11sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold"
                                android:background="@drawable/bg_badge_warning"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp" />
                        </RelativeLayout>

                        <!-- ITEM 6: CÂMARA 521 -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Câmara 521 atingiu 0,9 ºC"
                                    android:textColor="@color/primary_dark"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="12/08 · 23:14"
                                    android:textColor="@color/secondary_gray"
                                    android:textSize="11.5sp"
                                    android:fontFamily="@font/manrope"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:text="● Crítico"
                                android:textColor="#D97706"
                                android:textSize="11sp"
                                android:fontFamily="@font/manrope"
                                android:textStyle="bold"
                                android:background="@drawable/bg_badge_warning"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp" />
                        </RelativeLayout>

                        <!-- ITEM 7: CÂMARA 03 -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Câmara 03 atingiu 1,9 ºC"
                                    android:textColor="@color/primary_dark"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/manrope"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="14/08 · 10:22"
                                    android:textColor="@color/secondary_gray"
                                    android:textSize="11.5sp"
                                    android:fontFamily="@font/manrope"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
