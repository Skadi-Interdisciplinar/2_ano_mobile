<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".TrimmyActivity">

    <!-- CABEÇALHO AZUL ESCURO ARREDONDADO -->
    <LinearLayout
        android:id="@+id/headerTrimmy"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_rounded_bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="50dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope"
                android:text="Trimmy"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/manrope"
                android:text="Auxílio de IA"
                android:textColor="#A8C4DC"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- BOTÃO NOTIFICAÇÃO -->
        <FrameLayout
            android:id="@+id/btnNotification"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_circle_notif"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Notificações"
                android:src="@drawable/ic_bell_rounded" />
        </FrameLayout>

        <!-- AVATAR HEADER -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnProfileAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/white"
            app:strokeWidth="1.5dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/primary_light"
                android:contentDescription="Perfil"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/logo_skadi" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- ESTADO BLOQUEADO: PLANO BÁSICO (FIGMA GESTOR E FUNCIONÁRIO BÁSICO V1) -->
    <LinearLayout
        android:id="@+id/layoutTrimmyBlocked"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerTrimmy">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#CBD5E1"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_circle_light_blue">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="Bloqueado"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/primary_dark" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope"
                    android:gravity="center"
                    android:text="Funcionalidade do Plano Empresarial"
                    android:textColor="@color/primary_dark"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="22dp"
                    android:fontFamily="@font/manrope"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.2"
                    android:text="O assistente de inteligência artificial Trimmy é exclusivo do plano Empresarial. Faça upgrade para desbloquear diagnósticos preditivos e suporte em tempo real."
                    android:textColor="@color/secondary_gray"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUpgradeTrimmy"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:fontFamily="@font/manrope"
                    android:text="Fazer upgrade"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary_dark"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- ESTADO 1: TELA INICIAL DE BOAS-VINDAS (FIGMA TELA 1 DO TRIMMY) -->
    <LinearLayout
        android:id="@+id/layoutTrimmyWelcome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        app:layout_constraintBottom_toTopOf="@id/layoutChatInputBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerTrimmy">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:contentDescription="Logo Trimmy Skadi"
            android:src="@drawable/logo_skadi"
            app:tint="#0F2851" />

        <TextView
            android:id="@+id/tvTrimmyGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/manrope"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="Como podemos te ajudar hoje,\nMaria Eduarda?"
            android:textColor="#0F2851"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- SUGESTÕES RÁPIDAS -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chipSuggest1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_chip_filter_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/manrope"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="Quais câmaras estão críticas hoje?"
                android:textColor="#0F2851"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/chipSuggest2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_filter_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/manrope"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="Diagnóstico da Câmara 291"
                android:textColor="#0F2851"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ESTADO 2: CONVERSA ATIVA (FIGMA TELA 2 DO TRIMMY) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollTrimmyChat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutChatInputBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerTrimmy">

        <LinearLayout
            android:id="@+id/layoutChatMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- MENSAGEM 1: USUÁRIO (DIREITA) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="end|top"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="48dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_chat_bubble_user"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvInitialUserPrompt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope"
                        android:text="Quais câmaras estão críticas hoje?"
                        android:textColor="#0F2851"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/primary_light"
                        android:contentDescription="Usuário"
                        android:padding="4dp"
                        android:src="@drawable/logo_skadi" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- MENSAGEM 2: RESPOSTA DA IA TRIMMY (ESQUERDA - ESTRUTURADA COMO NO FIGMA) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="start|top"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_circle_navy_btn">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="Trimmy IA"
                        android:src="@drawable/logo_skadi" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="28dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chat_bubble_ai"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope"
                        android:lineSpacingExtra="2dp"
                        android:text="Analisei o monitoramento do Frigorífico Belterra em tempo real. No momento, 1 câmara apresenta estado crítico e 1 está em atenção:"
                        android:textColor="#334155"
                        android:textSize="12.5sp" />

                    <!-- CARD LARANJA: DIAGNÓSTICO DE ALERTA -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_chat_alert_box"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/manrope"
                            android:text="⚠️ Câmara 291 — 8,4°C (Crítico)"
                            android:textColor="#C2410C"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/manrope"
                            android:text="• Faixa ideal: 0°C a 2°C\n• Desvio registrado às 11:11 (+6,4°C acima do limite)\n• Câmara 61 também em atenção (2,3°C)"
                            android:textColor="#7C2D12"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <!-- CARD AZUL: RECOMENDAÇÃO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_chat_info_box"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/manrope"
                            android:text="💡 Plano de ação sugerido:"
                            android:textColor="#1D4ED8"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/manrope"
                            android:text="1. Verificar imediatamente o fechamento e vedação da porta da Câmara 291.\n2. Checar pressão do compressor secundário.\n3. Registrar justificativa na Central de Alertas após inspeção."
                            android:textColor="#1E3A8A"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BARRA DE DIGITAÇÃO (ACIMA DA TOOLBAR FLUTUANTE) -->
    <LinearLayout
        android:id="@+id/layoutChatInputBar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_search_bar"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="14dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavFloating"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <EditText
            android:id="@+id/etTrimmyMessage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/manrope"
            android:hint="Pergunte a Trimmy..."
            android:imeOptions="actionSend"
            android:inputType="textCapSentences"
            android:textColor="#0F2851"
            android:textColorHint="#94A3B8"
            android:textSize="13.5sp" />

        <FrameLayout
            android:id="@+id/btnSendTrimmy"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Enviar mensagem"
                android:src="@drawable/ic_send_navy" />
        </FrameLayout>
    </LinearLayout>

    <!-- TOOLBAR FLUTUANTE EM PÍLULA (COM TRIMMY EM DESTAQUE NO CÍRCULO) -->
    <LinearLayout
        android:id="@+id/bottomNavFloating"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_floating_bottom_bar"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 1. Câmaras -->
        <LinearLayout
            android:id="@+id/navCamaras"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Câmaras"
                android:src="@drawable/ic_snowflake" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/manrope"
                android:text="Câmaras"
                android:textColor="@color/primary_dark"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 2. Alertas -->
        <LinearLayout
            android:id="@+id/navAlertas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Alertas"
                android:src="@drawable/ic_megaphone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/manrope"
                android:text="Alertas"
                android:textColor="@color/primary_dark"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 3. Início -->
        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Início"
                android:src="@drawable/ic_home_navy" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/manrope"
                android:text="Início"
                android:textColor="@color/primary_dark"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 4. Relatórios -->
        <LinearLayout
            android:id="@+id/navRelatorios"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Relatórios"
                android:src="@drawable/ic_doc_report" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/manrope"
                android:text="Relatórios"
                android:textColor="@color/primary_dark"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 5. Trimmy (ABA ATIVA COM CÍRCULO AZUL MARINHO) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/navTrimmy"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_nav_home"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="Trimmy"
                    android:src="@drawable/ic_sparkle_trimmy_white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/manrope"
                    android:text="Trimmy"
                    android:textColor="@color/white"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
